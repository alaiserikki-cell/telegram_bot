GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

TELEGRAM_BOT_TOKEN=
# Numeric id of Meera's private notes channel, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Optional. Empty = drafts are posted in the notes channel as replies under each note.
# Set to Meera's private chat id to review drafts there instead.
REVIEW_CHAT_ID=

NEWS_LOOKBACK_DAYS=30
WEEKLY_CAP=3

# Vercel only (webhook mode). Leave SUPABASE_* empty on the laptop to use local files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=
CRON_SECRET=
